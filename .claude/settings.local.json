{
  "permissions": {
    "allow": [],
    "additionalDirectories": [
      "/Users/gaochong/develop/Sabaki/.claude"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/cache-session-title.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/check-no-window-sabaki.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/check-arch-boundaries.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "Review Claude's final response for this turn. If it completed or modified code but did NOT include a human acceptance checklist covering: 1) test classification, 2) architecture boundaries, 3) manual UI verification, then return {\"ok\":false,\"reason\":\"Before finishing, output a human acceptance checklist covering: test classification, architecture boundary compliance, and manual UI verification items.\"}. If it only answered a question or did exploratory work without code changes, return {\"ok\":true}. Otherwise return {\"ok\":true}."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/notify-claude-done.sh\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/notify-permission-needed.sh\""
          }
        ]
      }
    ]
  }
}
